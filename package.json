{
  "name": "logs-axi",
  "version": "0.1.0",
  "description": "Agent-ergonomic, token-efficient log CLI over CloudWatch, SigNoz and future sources (read-only, redacted by default)",
  "type": "module",
  "private": true,
  "bin": {
    "logs-axi": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "tsx bench/tokens.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1169.0",
    "@toon-format/toon": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "gpt-tokenizer": "^4.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
